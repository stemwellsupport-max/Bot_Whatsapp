    if (!el) return;
    el.classList.add('ripple-host');
    el.classList.toggle('ripple-clara', RIPPLE_CLARAS.some(function (c) { return el.classList.contains(c); }));
    var rect = el.getBoundingClientRect();
    var size = Math.max(rect.width, rect.height) * 1.6;
    var onda = document.createElement('span');
    onda.className = 'ripple-wave';
    onda.style.width = onda.style.height = size + 'px';
    onda.style.left = (e.clientX - rect.left - size / 2) + 'px';
    onda.style.top = (e.clientY - rect.top - size / 2) + 'px';
    el.appendChild(onda);
    setTimeout(function () { onda.remove(); }, 650);
  }, true);
})();
</script>
</body>
</html>
