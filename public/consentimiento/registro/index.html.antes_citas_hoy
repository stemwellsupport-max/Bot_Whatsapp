  function configurarAutocomplete(inputId, listaId, campo) {
    var input = document.getElementById(inputId);
    var lista = document.getElementById(listaId);

    function ocultar() { lista.classList.remove('mostrar'); lista.innerHTML = ''; }

    input.addEventListener('input', function () {
      var q = normalizar(input.value.trim());
      if (q.length < 2) { ocultar(); return; }
      var coincidencias = visitantesPrevios.filter(function (v) {
        return normalizar(v[campo]).indexOf(q) !== -1;
      }).slice(0, 8);
      if (!coincidencias.length) { ocultar(); return; }
      lista.innerHTML = coincidencias.map(function (v) {
        return '<div class="autocomplete-item">' +
          '<div class="ac-nombre">' + escapeHtml(v.nombre) + '</div>' +
          '<div class="ac-documento">' + escapeHtml(v.documento) + '</div>' +
        '</div>';
      }).join('');
      Array.prototype.forEach.call(lista.querySelectorAll('.autocomplete-item'), function (el, i) {
        el.addEventListener('click', function () { rellenarDesdeVisitante(coincidencias[i]); ocultar(); });
      });
      lista.classList.add('mostrar');
    });

    input.addEventListener('blur', function () { setTimeout(ocultar, 150); });
  }

  function escapeHtml(s) {
    return (s || '').toString().replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

