  // ── FIRMA (CANVAS) ──────────────────────────────────────────────────────
  var canvas = document.getElementById('firma-canvas');
  var ctx = canvas.getContext('2d');
  var wrap = document.getElementById('firma-wrap');
  var hint = document.getElementById('firma-hint');
  var pintando = false;
  var firmaTocada = false;

  function escalarFirma() {
    var rect = canvas.getBoundingClientRect();
    var ratio = window.devicePixelRatio || 1;
    canvas.width = Math.max(1, rect.width * ratio);
    canvas.height = Math.max(1, rect.height * ratio);
    ctx.scale(ratio, ratio);
    ctx.lineWidth = 2.2;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#1C2B26';
  }
  setTimeout(escalarFirma, 0);
  window.addEventListener('resize', escalarFirma);

  function posicionFirma(e) {
    var r = canvas.getBoundingClientRect();
    if (e.touches && e.touches.length) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }
  function iniciarFirma(e) {
    e.preventDefault();
    pintando = true;
    var p = posicionFirma(e);
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    hint.style.opacity = '0';
    wrap.classList.add('activo');
    firmaTocada = true;
  }
  function dibujarFirma(e) {
    e.preventDefault();
    if (!pintando) return;
    var p = posicionFirma(e);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
  }
  function detenerFirma() { pintando = false; }

  canvas.addEventListener('mousedown', iniciarFirma, { passive: false });
  canvas.addEventListener('mousemove', dibujarFirma, { passive: false });
  canvas.addEventListener('mouseup', detenerFirma);
  canvas.addEventListener('mouseleave', detenerFirma);
  canvas.addEventListener('touchstart', iniciarFirma, { passive: false });
  canvas.addEventListener('touchmove', dibujarFirma, { passive: false });
  canvas.addEventListener('touchend', detenerFirma);

  document.getElementById('btn-limpiar-firma').addEventListener('click', function () {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    hint.style.opacity = '1';
    wrap.classList.remove('activo');
    firmaTocada = false;
  });

  function marcarError(id, mostrar) {
