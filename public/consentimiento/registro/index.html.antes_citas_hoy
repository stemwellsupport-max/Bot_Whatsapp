    if (!document.getElementById('nombre').value.trim()) { marcarError('nombre', true); ok = false; } else marcarError('nombre', false);
    if (!document.getElementById('documento').value.trim()) { marcarError('documento', true); ok = false; } else marcarError('documento', false);
    if (!document.getElementById('motivo').value.trim()) { marcarError('motivo', true); ok = false; } else marcarError('motivo', false);
    if (!document.getElementById('contacto').value.trim()) { marcarError('contacto', true); ok = false; } else marcarError('contacto', false);
    if (!document.getElementById('telefono').value.trim()) { marcarError('telefono', true); ok = false; } else marcarError('telefono', false);

    var errFirma = document.getElementById('err-firma');
    if (!firmaTocada) { errFirma.classList.add('show'); ok = false; } else errFirma.classList.remove('show');

    if (!ok) {
