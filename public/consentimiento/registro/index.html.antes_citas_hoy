<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title id="page-title">Planilla de Registro · Stemwell</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --verde: #00B2C2; --verde-claro: #E6F7F9; --texto: #1C2B26; --gris: #6B7B76;
    --borde: #D4E6DF; --fondo: #F7FAF8; --blanco: #FFFFFF; --error: #C0392B; --max-w: 560px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Poppins', sans-serif; background: var(--fondo); color: var(--texto); min-height: 100vh; display: flex; flex-direction: column; }
  .header { background: var(--blanco); border-bottom: 1px solid var(--borde); padding: 10px 24px; display: flex; align-items: center; position: sticky; top: 0; z-index: 10; }
  .header img { height: 54px; width: auto; }
  .container { max-width: var(--max-w); width: 100%; margin: 0 auto; padding: 14px 20px 24px; flex: 1; display: flex; flex-direction: column; justify-content: center; }
  @media (min-width: 700px) { :root { --max-w: 680px; } }
  @media (min-width: 1000px) { :root { --max-w: 900px; } }
  @media (min-width: 1300px) { :root { --max-w: 1100px; } }
  @media (min-width: 1600px) { :root { --max-w: 1350px; } }
  @media (min-width: 1850px) { :root { --max-w: 1650px; } }
  .titulo-simple { margin-bottom: clamp(12px, 1.4vh, 18px); }
  .titulo-simple h2 { font-size: clamp(22px, 2.6vw, 36px); font-weight: 800; color: var(--verde); margin-bottom: 6px; }
  .titulo-simple p { font-size: clamp(13px, 1vw, 15px); color: var(--gris); line-height: 1.4; }
  .section { background: var(--blanco); border-radius: 16px; padding: clamp(16px, 2.2vh, 26px) clamp(18px, 1.8vw, 26px); margin-bottom: clamp(10px, 1.6vh, 16px); border: 1px solid var(--borde); }
  .section-title { font-size: clamp(12px, 1vw, 13.5px); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--verde); margin-bottom: clamp(10px, 1.8vh, 18px); }
  .field { margin-bottom: clamp(10px, 1.6vh, 16px); }
  .field:last-child { margin-bottom: 0; }
  label.campo-label { display: block; font-size: clamp(12.5px, 1vw, 15px); font-weight: 500; color: var(--gris); margin-bottom: 6px; }
  label.campo-label span.req { color: var(--verde); margin-left: 2px; }
  input[type="text"], input[type="tel"], input[type="date"], input[type="time"], select {
    width: 100%; padding: clamp(11px, 1.5vh, 15px) 16px; border: 1.5px solid var(--borde); border-radius: 11px;
    font-family: 'Poppins', sans-serif; font-size: clamp(15px, 1.3vw, 19px); color: var(--texto); background: var(--fondo);
    transition: border-color .2s, box-shadow .2s; -webkit-appearance: none;
  }
  input:focus, select:focus { outline: none; border-color: var(--verde); box-shadow: 0 0 0 3px rgba(0,178,194,.12); background: var(--blanco); }
  input.error, select.error { border-color: var(--error); }
  .field-error { font-size: 11.5px; color: var(--error); margin-top: 4px; display: none; }
  .field-error.show { display: block; }

  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 460px) { .row-2 { grid-template-columns: 1fr; } }

  /* ── AUTOCOMPLETAR VISITANTES YA REGISTRADOS ──
     Segunda+ visita: en vez de volver a escribir todo (y equivocarse),
     eligen su nombre/documento de una lista y se rellena el resto. */
  .campo-autocomplete { position: relative; }
  .autocomplete-lista {
    display: none; position: absolute; left: 0; right: 0; top: calc(100% + 4px);
    background: var(--blanco); border: 1.5px solid var(--borde); border-radius: 12px;
    box-shadow: 0 10px 28px rgba(0,0,0,.12); max-height: 260px; overflow-y: auto; z-index: 30;
  }
  .autocomplete-lista.mostrar { display: block; }
  .autocomplete-item { padding: 12px 16px; cursor: pointer; border-bottom: 1px solid var(--borde); }
  .autocomplete-item:last-child { border-bottom: none; }
  .autocomplete-item:hover, .autocomplete-item.activo { background: var(--verde-claro); }
  .autocomplete-item .ac-nombre { font-size: 14.5px; font-weight: 600; color: var(--texto); }
  .autocomplete-item .ac-documento { font-size: 12.5px; color: var(--gris); margin-top: 2px; }
  .autocomplete-vacio { padding: 12px 16px; font-size: 13px; color: var(--gris); }

  /* Red de seguridad para pantallas bajas (poco alto disponible): reduce el espaciado para seguir cabiendo sin scroll, sin afectar el tamaño amplio que se usa en la tablet real (1920x1080). */
  @media (max-height: 820px) {
    .header { padding: 6px 24px; }
    .header img { height: 40px; }
    .titulo-simple { margin-bottom: 6px !important; }
    .titulo-simple h2 { font-size: 22px !important; }
    .titulo-simple p { display: none; }
    .section { padding: 10px clamp(16px, 1.6vw, 22px) !important; margin-bottom: 6px !important; }
    .field { margin-bottom: 6px !important; }
    input[type="text"], input[type="tel"], input[type="email"], input[type="date"], input[type="time"], textarea { padding: 7px 14px !important; }
    textarea { min-height: 46px !important; }
  }

  /* En tablet/escritorio los datos van a la izquierda y la firma a la
     derecha, aprovechando el ancho en vez de apilar todo verticalmente
     (que obliga a mucho scroll en una tablet). */
  @media (min-width: 900px) {
    .registro-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: stretch; }
    .registro-columna-izquierda { display: flex; flex-direction: column; }
    .registro-columna-izquierda .section { flex: 1; display: flex; flex-direction: column; justify-content: center; }
    .registro-columna-derecha { display: flex; flex-direction: column; height: 100%; }
    .registro-columna-derecha .section { display: flex; flex-direction: column; flex: 1; }
    .registro-columna-derecha .firma-wrap { flex: 1; display: flex; flex-direction: column; }
    .registro-columna-derecha canvas.firma-canvas { flex: 1; height: auto; min-height: 320px; }
    .registro-columna-derecha .botones-form { margin-top: 16px; }
  }

  /* ── FIRMA (CANVAS) ── */
  .firma-wrap {
    position: relative; border: 2px dashed var(--borde); border-radius: 14px;
    background: var(--fondo); overflow: hidden; transition: border-color .2s;
  }
  .firma-wrap.activo { border-color: var(--verde); border-style: solid; }
  .firma-hint {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center;
    justify-content: center; pointer-events: none; transition: opacity .3s; gap: 6px;
  }
  .firma-hint svg { opacity: .25; }
  .firma-hint p { font-size: 12.5px; color: var(--gris); opacity: .7; font-weight: 400; }
  canvas.firma-canvas { display: block; width: 100%; height: min(30vh, 260px); touch-action: none; cursor: crosshair; }
  .firma-actions { display: flex; justify-content: flex-end; padding: 8px 12px; border-top: 1px solid var(--borde); background: var(--blanco); }
  .btn-limpiar {
    font-size: 12px; color: var(--gris); background: none; border: 1px solid var(--borde); border-radius: 7px;
    padding: 5px 12px; cursor: pointer; font-family: 'Poppins', sans-serif; transition: all .2s;
  }
  .btn-limpiar:hover { border-color: var(--error); color: var(--error); }
  .firma-error { font-size: 11.5px; color: var(--error); margin-top: 6px; display: none; }
  .firma-error.show { display: block; }

  .btn-enviar {
    width: 100%; padding: 16px; background: var(--verde); color: white; border: none; border-radius: 14px;
    font-family: 'Poppins', sans-serif; font-size: 16.5px; font-weight: 600; cursor: pointer; transition: all .2s;
    display: flex; align-items: center; justify-content: center; gap: 10px;
  }
  .btn-enviar:hover:not(:disabled) { background: #0093a0; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(0,178,194,.3); }
  .btn-enviar:disabled { opacity: .6; cursor: not-allowed; }
  .btn-secundario {
    padding: 14px 22px; background: none; color: var(--gris); border: 1.5px solid var(--borde); border-radius: 14px;
    font-family: 'Poppins', sans-serif; font-size: 14.5px; font-weight: 500; cursor: pointer; transition: all .2s; white-space: nowrap;
  }
  .btn-secundario:hover { border-color: var(--verde); color: var(--verde); }
  .botones-form { display: flex; gap: 12px; margin-top: 6px; }
  .botones-form .btn-enviar { flex: 1; }
  .spinner { width: 20px; height: 20px; border: 2px solid rgba(255,255,255,.3); border-top-color: white; border-radius: 50%; animation: spin .7s linear infinite; display: none; }
  @keyframes spin { to { transform: rotate(360deg); } }

  #pantalla-exito { display: none; flex-direction: column; align-items: center; text-align: center; padding: 60px 24px; }
  .exito-icono { width: 80px; height: 80px; background: var(--verde-claro); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 22px; }
  .exito-icono svg { width: 40px; height: 40px; }
  #pantalla-exito h2 { font-size: 24px; color: var(--verde); margin-bottom: 10px; font-weight: 700; }
  #pantalla-exito p { font-size: 14.5px; color: var(--gris); line-height: 1.65; max-width: 360px; }

  /* ── EFECTO "RIPPLE" AL TOCAR (feedback moderno) ── */
  .ripple-host { position: relative; }
  .ripple-host:not(.icono-esquina) { overflow: hidden; }
  .ripple-host:active { transform: scale(.97); }
  .ripple-wave {
    position: absolute; border-radius: 50%; transform: scale(0); opacity: .55;
    background: currentColor; mix-blend-mode: overlay; pointer-events: none;
    animation: ripple-expandir .6s ease-out forwards;
  }
  .ripple-host.ripple-clara .ripple-wave { background: var(--verde); mix-blend-mode: normal; opacity: .18; }
  @keyframes ripple-expandir { to { transform: scale(1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .ripple-wave { display: none; } }
  /* Puerta del evento: pregunta de grabación + documento firmable */
  #pantalla-grabacion { max-width: 820px; margin: 0 auto; padding: 8px 4px 40px; }
  #pantalla-grabacion h2 { font-size: 22px; margin: 6px 0 8px; }
  #pantalla-grabacion p { font-size: 15px; line-height: 1.5; margin: 0 0 14px; }
  .gr-botones { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px; }
  .gr-botones button { flex: 1 1 220px; min-height: 56px; font-size: 17px; }
  .gr-paginas { max-height: 56vh; overflow-y: auto; border: 1px solid var(--borde); border-radius: 10px; background: #fff; padding: 8px; }
  .gr-paginas img { display: block; width: 100%; height: auto; margin: 0 0 10px; border: 1px solid var(--borde); }
  .gr-acepto { display: flex; gap: 10px; align-items: flex-start; margin: 14px 0 6px; font-size: 15px; line-height: 1.4; }
  .gr-acepto input { width: 22px; height: 22px; margin-top: 2px; flex: none; }
  /* Puerta del evento: servicios que desea realizarse */
  #pantalla-servicios { max-width: 820px; margin: 0 auto; padding: 8px 4px 40px; }
  #pantalla-servicios h2 { font-size: 22px; margin: 6px 0 8px; }
  #pantalla-servicios p { font-size: 15px; line-height: 1.5; margin: 0 0 14px; }
  .sv-lista { display: flex; flex-direction: column; gap: 12px; }
  .sv-item { display: flex; gap: 14px; align-items: center; padding: 16px 18px; border: 2px solid var(--borde); border-radius: 14px; background: #fff; cursor: pointer; font-size: 17px; }
  .sv-item.on { border-color: var(--verde); background: #E7F6EF; }
  .sv-item input { width: 26px; height: 26px; flex: none; }
  .sv-item small { display: block; font-size: 13px; opacity: .7; }
</style>
</head>
<body>

<header class="header"><img src="/images/STEMWELL_LOGO_.png" alt="Stemwell" /></header>

<div class="container">
  <div id="pantalla-form">
    <div class="titulo-simple">
      <h2 id="txt-titulo">&nbsp;</h2>
      <p id="txt-intro"></p>
    </div>

    <div class="registro-2col">
    <div class="registro-columna-izquierda">
    <div class="section">
      <div class="section-title" id="txt-section-visitante"></div>
      <div class="row-2">
        <div class="field">
          <label class="campo-label" id="lbl-fecha"></label>
          <input type="date" id="fecha" />
          <div class="field-error" id="err-fecha"></div>
        </div>
        <div class="field campo-autocomplete">
          <label class="campo-label" id="lbl-nombre"></label>
          <input type="text" id="nombre" autocomplete="off" />
          <div class="autocomplete-lista" id="sugerencias-nombre"></div>
          <div class="field-error" id="err-nombre"></div>
        </div>
      </div>
      <div class="row-2">
        <div class="field campo-autocomplete">
          <label class="campo-label" id="lbl-documento"></label>
          <input type="text" id="documento" inputmode="numeric" autocomplete="off" />
          <div class="autocomplete-lista" id="sugerencias-documento"></div>
          <div class="field-error" id="err-documento"></div>
        </div>
        <div class="field">
          <label class="campo-label" id="lbl-rh"></label>
          <select id="rh">
            <option value="">…</option>
            <option value="O+">O+</option>
            <option value="O-">O-</option>
            <option value="A+">A+</option>
            <option value="A-">A-</option>
            <option value="B+">B+</option>
            <option value="B-">B-</option>
            <option value="AB+">AB+</option>
            <option value="AB-">AB-</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label class="campo-label" id="lbl-motivo"></label>
        <input type="text" id="motivo" />
        <div class="field-error" id="err-motivo"></div>
      </div>
      <div class="field">
        <label class="campo-label" id="lbl-eps"></label>
        <input type="text" id="eps" />
      </div>
    </div>

    <div class="section">
      <div class="section-title" id="txt-section-emergencia"></div>
      <div class="row-2">
        <div class="field">
          <label class="campo-label" id="lbl-contacto"></label>
          <input type="text" id="contacto" />
          <div class="field-error" id="err-contacto"></div>
        </div>
        <div class="field">
          <label class="campo-label" id="lbl-telefono"></label>
          <input type="tel" id="telefono" inputmode="tel" />
          <div class="field-error" id="err-telefono"></div>
        </div>
      </div>
      <div class="field">
        <label class="campo-label" id="lbl-hora-ingreso"></label>
        <input type="time" id="hora-ingreso" />
      </div>
    </div>
    </div>

    <div class="registro-columna-derecha">
    <div class="section">
      <div class="section-title" id="txt-section-firma"></div>
      <div class="firma-wrap" id="firma-wrap">
        <div class="firma-hint" id="firma-hint">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          <p id="txt-firma-hint"></p>
        </div>
        <canvas class="firma-canvas" id="firma-canvas"></canvas>
        <div class="firma-actions"><button class="btn-limpiar" id="btn-limpiar-firma" type="button"></button></div>
      </div>
      <div class="field-error" id="err-firma"></div>
    </div>

    <div class="botones-form">
      <button class="btn-secundario" id="btn-inicio" type="button"></button>
      <button class="btn-enviar" id="btn-enviar" type="button">
        <span id="btn-texto"></span>
        <div class="spinner" id="spinner"></div>
      </button>
    </div>
    </div>
    </div>
  </div>

  <!-- Puerta del evento: ¿desea ser grabado? Si sí, lee y firma el documento -->
  <div id="pantalla-grabacion" style="display:none">
    <div id="gr-pregunta">
      <h2 id="gr-titulo"></h2>
      <p id="gr-texto"></p>
      <div class="gr-botones">
        <button type="button" class="btn-enviar" id="gr-si"></button>
        <button type="button" class="btn-secundario" id="gr-no"></button>
      </div>
    </div>
    <div id="gr-doc" style="display:none">
      <h2 id="gr-doc-titulo"></h2>
      <p id="gr-doc-ayuda"></p>
      <div id="gr-paginas" class="gr-paginas"></div>
      <label class="gr-acepto"><input type="checkbox" id="gr-leido"> <span id="gr-leido-txt"></span></label>
      <div class="section-title" id="gr-firma-titulo"></div>
      <div class="firma-wrap" id="gr-firma-wrap">
        <canvas class="firma-canvas" id="gr-canvas" style="height:220px"></canvas>
        <div class="firma-actions"><button class="btn-limpiar" id="gr-limpiar" type="button"></button></div>
      </div>
      <div class="field-error" id="gr-err"></div>
      <div class="gr-botones">
        <button type="button" class="btn-secundario" id="gr-atras"></button>
        <button type="button" class="btn-enviar" id="gr-firmar"></button>
      </div>
    </div>
  </div>

  <!-- Puerta del evento: ¿qué desea realizarse? -->
  <div id="pantalla-servicios" style="display:none">
    <h2 id="sv-titulo"></h2>
    <p id="sv-texto"></p>
    <div id="sv-lista" class="sv-lista"></div>
    <div class="field-error" id="sv-err"></div>
    <div class="gr-botones">
      <button type="button" class="btn-secundario" id="sv-volver"></button>
      <button type="button" class="btn-enviar" id="sv-continuar"></button>
    </div>
  </div>

  <div id="pantalla-exito">
    <div class="exito-icono">
      <svg viewBox="0 0 24 24" fill="none" stroke="#1A7A5E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>
      </svg>
    </div>
    <h2 id="txt-gracias-titulo"></h2>
    <p id="txt-gracias-texto"></p>
  </div>
</div>

<script>
(function () {
  'use strict';

  var TEXTOS = {
    es: {
      tituloPagina: 'Planilla de Registro · Stemwell',
      titulo: 'Planilla de Registro',
      intro: 'Registra tu visita a nuestras instalaciones. Código SGSST-F02.',
      sectionVisitante: 'Datos del visitante',
      sectionEmergencia: 'Contacto de emergencia',
      sectionFirma: 'Firma',
      fecha: 'Fecha', nombre: 'Nombre', documento: 'Documento', rh: 'RH',
      motivo: 'Motivo de visita', eps: 'EPS',
      contacto: 'Contacto de emergencia', telefono: 'Número telefónico',
      horaIngreso: 'Hora de ingreso',
      erFecha: 'Selecciona la fecha', erNombre: 'Ingresa el nombre',
      erDocumento: 'Ingresa el documento', erMotivo: 'Ingresa el motivo de visita',
      erContacto: 'Ingresa el contacto de emergencia', erTelefono: 'Ingresa el número telefónico',
      firmaHint: 'Firma aquí', limpiar: '✕ Limpiar', erFirma: 'Debes firmar para continuar',
      inicio: '← Inicio', enviar: 'Guardar registro', enviando: 'Guardando…',
      graciasTitulo: '¡Registro guardado!', graciasTexto: 'Tu visita quedó registrada correctamente.',
      errorGuardar: 'Hubo un problema al guardar el registro. Verifica la conexión e intenta de nuevo.'
    },
    en: {
      tituloPagina: 'Registration Log · Stemwell',
      titulo: 'Registration Log',
      intro: 'Register your visit to our facility. Code SGSST-F02.',
      sectionVisitante: 'Visitor information',
      sectionEmergencia: 'Emergency contact',
      sectionFirma: 'Signature',
      fecha: 'Date', nombre: 'Name', documento: 'ID document', rh: 'Blood type',
      motivo: 'Reason for visit', eps: 'Health insurance (EPS)',
      contacto: 'Emergency contact', telefono: 'Phone number',
      horaIngreso: 'Check-in time',
      erFecha: 'Please select a date', erNombre: 'Enter the name',
      erDocumento: 'Enter the ID document', erMotivo: 'Enter the reason for visit',
      erContacto: 'Enter the emergency contact', erTelefono: 'Enter the phone number',
      firmaHint: 'Sign here', limpiar: '✕ Clear', erFirma: 'You must sign to continue',
      inicio: '← Home', enviar: 'Save registration', enviando: 'Saving…',
      graciasTitulo: 'Registration saved!', graciasTexto: 'Your visit was recorded successfully.',
      errorGuardar: 'There was a problem saving the registration. Check your connection and try again.'
    }
  };

  var params = new URLSearchParams(window.location.search);
  var lang = params.get('lang') === 'en' ? 'en' : 'es';
  var t = TEXTOS[lang];
  document.documentElement.lang = lang;

  document.getElementById('page-title').textContent = t.tituloPagina;
  document.getElementById('txt-titulo').textContent = t.titulo;
  document.getElementById('txt-intro').textContent = t.intro;
  document.getElementById('txt-section-visitante').textContent = t.sectionVisitante;
  document.getElementById('txt-section-emergencia').textContent = t.sectionEmergencia;
  document.getElementById('txt-section-firma').textContent = t.sectionFirma;
  document.getElementById('lbl-fecha').innerHTML = t.fecha + ' <span class="req">*</span>';
  document.getElementById('lbl-nombre').innerHTML = t.nombre + ' <span class="req">*</span>';
  document.getElementById('lbl-documento').innerHTML = t.documento + ' <span class="req">*</span>';
  document.getElementById('lbl-rh').textContent = t.rh;
  document.getElementById('lbl-motivo').innerHTML = t.motivo + ' <span class="req">*</span>';
  document.getElementById('lbl-eps').textContent = t.eps;
  document.getElementById('lbl-contacto').innerHTML = t.contacto + ' <span class="req">*</span>';
  document.getElementById('lbl-telefono').innerHTML = t.telefono + ' <span class="req">*</span>';
  document.getElementById('lbl-hora-ingreso').textContent = t.horaIngreso;
